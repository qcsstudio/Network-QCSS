{
  "name": "network-qcss",
  "version": "1.0.0",
  "private": true,
  "description": "Robust Next.js product for network services, cybersecurity lead generation, diagnostic tools, automation, and admin intelligence.",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "env:check": "node scripts/check-env.mjs",
    "deploy:check": "npm run env:check && npm run prisma:generate && npm run typecheck && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "site:qa": "node scripts/site-qa.mjs",
    "frontend:qa": "playwright test tests/frontend-qa.spec.ts",
    "test:content": "tsx --test tests/advisory-source-parsers.test.mjs && node --experimental-strip-types --test tests/automation-auth.test.mjs tests/blog-presentation.test.mjs tests/content-admin-domain.test.mjs tests/content-radar-domain.test.mjs tests/editorial-automation.test.mjs tests/editorial-citations.test.mjs tests/editorial-image-agents.test.mjs tests/editorial-image-prompt.test.mjs tests/editorial-image-state.test.mjs tests/editorial-publication-policy.test.mjs tests/editorial-source-policy.test.mjs tests/editorial-story-lineage.test.mjs tests/editorial-visuals.test.mjs tests/linkedin-commentary.test.mjs tests/openai-config.test.mjs tests/procedural-editorial-visual.test.mjs tests/social-publication-state.test.mjs",
    "test:verifygrid": "node --experimental-strip-types --test tests/verifygrid-domain.test.mjs",
    "test:email": "node --experimental-strip-types --test tests/email-config.test.mjs",
    "content:seed": "node scripts/seed-content-studio.mjs",
    "content:audit": "tsx -r dotenv/config scripts/audit-editorial-library.ts",
    "content:images:backfill": "tsx -r dotenv/config scripts/backfill-editorial-images.ts",
    "content:images:carry-forward": "tsx -r dotenv/config scripts/carry-forward-editorial-images.ts",
    "content:upgrade-library": "tsx -r dotenv/config scripts/upgrade-editorial-library.ts",
    "advisories:verify-sources": "tsx scripts/verify-advisory-sources.ts",
    "linkedin:audit": "tsx -r dotenv/config scripts/audit-recent-linkedin.ts",
    "linkedin:rebuild": "tsx -r dotenv/config scripts/rebuild-recent-linkedin.ts",
    "openai:test": "node scripts/test-openai-connection.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "csv-parse": "^7.0.1",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^0.560.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "openai": "^7.1.0",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.35.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "prisma": "7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "postcss": "8.5.23",
    "sharp": "$sharp"
  }
}
