NEXT_PUBLIC_SITE_URL=https://network.qcss.example
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
NEXT_PUBLIC_CONVERSION_CURRENCY=INR
NEXT_PUBLIC_LEAD_CONVERSION_VALUE=0
NEXT_PUBLIC_ASSESSMENT_CONVERSION_VALUE=0
STORE_DRIVER=file
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/network_qcss?schema=public
ADMIN_EMAIL=admin@network-qcss.local
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret
ADMIN_API_TOKEN=change-this-api-token
CRON_SECRET=change-this-long-random-secret
VERIFYGRID_PORTAL_SESSION_SECRET=change-this-long-random-secret
VERIFYGRID_WEBAUTHN_RP_ID=www.qcsstudio.com
VERIFYGRID_WEBAUTHN_ORIGIN=https://www.qcsstudio.com
VERIFYGRID_REPORT_SIGNING_PRIVATE_KEY=
VERIFYGRID_REPORT_SIGNING_PUBLIC_KEY=
NVD_API_KEY=
# Connector profiles reference these prefixes; secrets remain in Vercel, never in the database.
VERIFYGRID_TENABLE_ACCESS_KEY=
VERIFYGRID_TENABLE_SECRET_KEY=
VERIFYGRID_QUALYS_USERNAME=
VERIFYGRID_QUALYS_PASSWORD=
VERIFYGRID_RAPID7_USERNAME=
VERIFYGRID_RAPID7_PASSWORD=
CRM_PROVIDER=none
LEAD_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
RESEND_API_KEY=
# Prefer SMTP for Gmail. Use a Google App Password, never the account password.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_TEST_TO=
LEAD_ALERT_EMAIL_FROM=
LEAD_ALERT_EMAIL_TO=
VERIFYGRID_EMAIL_FROM=
VERIFYGRID_ONBOARDING_ALERT_TO=
ZOHO_ACCESS_TOKEN=
ZOHO_CRM_LEADS_URL=
ZOHO_FIELD_MAPPING_JSON=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_FIELD_MAPPING_JSON=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WEBHOOK_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://www.qcsstudio.com/api/integrations/linkedin/callback
LINKEDIN_TOKEN_ENCRYPTION_KEY=
LINKEDIN_API_VERSION=202607
# Direct OpenAI API only. The application does not use Vercel AI Gateway.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT_ID=
EDITORIAL_CONTENT_WRITER_MODEL=gpt-4.1-mini
EDITORIAL_CONTENT_CRITIC_MODEL=gpt-4.1-mini
ADVISORY_ENRICHMENTS_PER_RUN=1
EDITORIAL_DIRECTOR_MODEL=gpt-4.1-mini
EDITORIAL_IMAGE_MODEL=gpt-image-2
EDITORIAL_IMAGE_TIMEOUT_MS=270000
EDITORIAL_CRITIC_MODEL=gpt-4.1-mini
EDITORIAL_IMAGE_QUALITY=high
EDITORIAL_IMAGE_ATTEMPTS_PER_RUN=1
# Advisories use the zero-cost QCS procedural renderer. FLUX is reserved for weekly editorial posts.
BFL_API_KEY=
EDITORIAL_BFL_MODEL=flux-2-max
EDITORIAL_PAID_IMAGES_DAILY_LIMIT=2
EDITORIAL_PAID_IMAGES_MONTHLY_LIMIT=12
# Disabled by default so an unavailable FLUX account cannot silently trigger premium OpenAI image charges.
EDITORIAL_IMAGE_OPENAI_FALLBACK=0
