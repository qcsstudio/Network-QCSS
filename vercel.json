{
  "git": {
    "deploymentEnabled": {
      "qcs-reviewed-advisory-rollout": false
    }
  },
  "crons": [
    {
      "path": "/api/admin/content-radar",
      "schedule": "0 4 * * 1,4"
    },
    {
      "path": "/api/cron/advisory-discovery",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/content-editorial",
      "schedule": "47 3 * * *"
    },
    {
      "path": "/api/cron/ccna-daily",
      "schedule": "35 2 * * 1-5"
    }
  ],
  "buildCommand": "node scripts/verifygrid-production-preflight.mjs && npm run build"
}
